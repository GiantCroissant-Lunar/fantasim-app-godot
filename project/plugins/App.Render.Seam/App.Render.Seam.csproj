<Project Sdk="Godot.NET.Sdk/4.7.0">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.Render.Seam</RootNamespace>
    <AssemblyName>FantaSim.App.Render.Seam</AssemblyName>
    <ServiceArchiTier>T4</ServiceArchiTier>
    <!-- The RESIDENT render seam: implements IViewportCapture with the Godot main viewport and
         registers the render.screenshot command against the resident App.Command IService.
         Godot.NET.Sdk for GodotSharp. Stays resident (shared via "FantaSim.App." prefix) - it
         is the only Godot-aware piece; App.Render (T3) ships no Godot types and the command's
         payload/path/timestamp logic is unit-tested without Godot. Mirrors App.Camera.Seam /
         App.Timeline.Seam. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>

  <ItemGroup>
    <!-- T3 render support (Godot-free payload/path/timestamp logic + IViewportCapture). -->
    <ProjectReference Include="..\App.Render\App.Render.csproj" />
    <!-- T1 command contract lets the resident seam register render.screenshot without depending
         on the T3 command implementation. -->
    <ProjectReference Include="..\..\contracts\App.Command\App.Command.csproj" />
    <ProjectReference Include="..\App.Common\App.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>

</Project>