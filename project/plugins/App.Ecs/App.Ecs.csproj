<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.Ecs</RootNamespace>
    <AssemblyName>FantaSim.App.Ecs</AssemblyName>
    <ServiceArchiTier>T3</ServiceArchiTier>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>

  <!--
    T3 ECS field-reduction path. World-lib packages are referenced only when
    UseProjectReferences=true, so the default build compiles only the Akka/ECS actor spine.
    The field components + ReduceFieldsSystem are compiled under USE_PROJECT_REFERENCES.
    T1 contracts (App.Ecs.Contracts) never reference world-lib types.
  -->
  <PropertyGroup Condition="'$(UseProjectReferences)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_PROJECT_REFERENCES</DefineConstants>
  </PropertyGroup>

  <!--
    InternalsVisibleTo: EcsWorldActor/EcsSupervisorActor/EcsMessages + the ECS field components
    and ReduceFieldsSystem are internal so they are not part of the plugin's public surface.
    Behavioral coverage of supervisor routing, world lifecycle, duplicate handling, UpdateAll
    fan-out, supervision, and field reduction determinism requires direct TestKit / type access
    to these actors and components. The minimal attribute below exposes them to the test
    assembly only; no other assembly gains access and no public API is added.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="App.Ecs.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\contracts\App.Ecs\App.Ecs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnifyEcs.Core" />
    <PackageReference Include="UnifyEcs.Runtime.Arch" />
    <PackageReference Include="GiantCroissant.CrosscutFoundation.Messaging.Contracts" />
    <PackageReference Include="Akka" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    World-lib field contracts/plugins. TruthStream is not referenced here: ReduceFieldsSystem
    is reducer/catalog-only; the cross-path determinism test pulls TruthStream itself.
  -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <PackageReference Include="GiantCroissant.FantaSim.World.Fields.Contracts" />
    <PackageReference Include="GiantCroissant.FantaSim.World.Fields.Core" />
  </ItemGroup>
</Project>
