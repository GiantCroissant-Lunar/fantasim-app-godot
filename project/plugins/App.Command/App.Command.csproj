<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.Command</RootNamespace>
    <AssemblyName>FantaSim.App.Command</AssemblyName>
    <ServiceArchiTier>T3</ServiceArchiTier>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>

  <!--
    App.Command.Tests exercises LocalOrchestrator and Service internals against fakes
    registered in the IRegistry. The orchestrator resolves App.World / App.Ecs services
    via ServiceArchi IRegistry.Get<T>; the test fakes live in the test assembly.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="App.Command.Tests" />
  </ItemGroup>

  <!--
    T3 command orchestrator. App-side T1 contracts are always referenced. The iii native
    bridge (Rust/Hermes) is deferred behind the IiiBridgeOrchestrator stub; this project
    does not reference App.Agent, App.Stage, or any Hermes/Python bridge. Resident Command
    resolves App.World only through the contract (FantaSim.App.World.Contracts): the impl
    now travels in the collectible world bundle, and LocalOrchestrator tolerates its absence.
  -->
  <ItemGroup>
    <ProjectReference Include="..\App.Common\App.Common.csproj" />
    <ProjectReference Include="..\..\contracts\App.Command\App.Command.csproj" />
    <ProjectReference Include="..\..\contracts\App.World\App.World.csproj" />
    <ProjectReference Include="..\..\contracts\App.Ecs\App.Ecs.csproj" />
    <ProjectReference Include="..\..\contracts\App.Resource\App.Resource.csproj" />
    <ProjectReference Include="..\..\contracts\App.SceneFlow\App.SceneFlow.csproj" />
    <ProjectReference Include="..\..\contracts\App.Ui\App.Ui.csproj" />
    <ProjectReference Include="..\..\contracts\App.Activity\App.Activity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GiantCroissant.ServiceArchi.Contracts" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="GiantCroissant.CrosscutFoundation.Messaging.Contracts" />
  </ItemGroup>

</Project>
