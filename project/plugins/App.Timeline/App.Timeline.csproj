<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.Timeline</RootNamespace>
    <AssemblyName>FantaSim.App.Timeline</AssemblyName>
    <!-- ServiceArchi Tier 3: engine-agnostic timeline orchestrator. Owns the playback state
         machine and registers the timeline scene plugin. The pure UI model helpers and
         ITimelineFace live in contracts/App.Timeline so the resident T4 seam can compile without
         referencing this collectible T3 implementation. Pure C# (Microsoft.NET.Sdk, not
         Godot.NET.Sdk); T3 never references T4. Mirrors App.Camera. -->
    <ServiceArchiTier>T3</ServiceArchiTier>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>

  <ItemGroup>
    <!-- T1 contracts (IService, DTOs, T2 proxy). -->
    <ProjectReference Include="..\..\contracts\App.Timeline\App.Timeline.csproj" />
    <ProjectReference Include="..\..\contracts\App.Command\App.Command.csproj" />
    <ProjectReference Include="..\..\contracts\App.Resource\App.Resource.csproj" />
    <!-- App.World contracts hold ITimelineController + SphereRegimeSchedule the model consumes,
         plus ILayerTrackRegistry. The registry INSTANCE is owned by the world bundle's
         WorldPlugin; a plugin-assembly reference to App.World.Composition from here dual-copies
         8 Unify assemblies across the timeline and world collectible ALCs (verified via the
         stager's dual-copy check, 2026-07-10), the type-identity-split incident class. This
         project therefore consumes the shared T1 contract ONLY. -->
    <ProjectReference Include="..\..\contracts\App.World\App.World.csproj" />
    <!-- SceneFlow contracts for the scene-tier activator. -->
    <ProjectReference Include="..\..\contracts\App.SceneFlow\App.SceneFlow.csproj" />
    <ProjectReference Include="..\..\contracts\Cross.Abstractions\Cross.Abstractions.csproj" />
    <ProjectReference Include="..\..\generators\Cross.SourceGenerators\Cross.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GiantCroissant.ServiceArchi.Contracts" Version="0.1.1" />
    <PackageReference Include="GiantCroissant.PluginArchi.Extensibility.Abstractions" Version="0.1.6" />
    <PackageReference Include="GiantCroissant.PluginArchi.SourceGenerators" Version="0.1.6" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>

</Project>
