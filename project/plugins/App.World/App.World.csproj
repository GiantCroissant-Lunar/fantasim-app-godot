<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.World</RootNamespace>
    <AssemblyName>FantaSim.App.World</AssemblyName>
    <ServiceArchiTier>T3</ServiceArchiTier>
    <UnifyStorageBackends>SurrealDb</UnifyStorageBackends>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
    <CompilerVisibleProperty Include="UnifyStorageBackends" />
  </ItemGroup>

  <!-- App.World.Tests constructs WorldRuntime with explicit descriptors to prove the startup
       catalog validation contract (duplicate FieldId throws). No other assembly gains access. -->
  <ItemGroup>
    <InternalsVisibleTo Include="App.World.Tests" />
  </ItemGroup>

  <!--
    T3 world orchestrator (zero Godot usings; the Godot work lives in the future App.World.Seam T4).
    App-side T1 contracts are always referenced. The engine refs below switch package<->project by
    UseProjectReferences (see project/Directory.Build.props): when false the StubWorldRuntime compiles
    against published packages; when true the full composition path (USE_PROJECT_REFERENCES) compiles
    against fantasim-world `main` projects. On the Phase 0 branch the default is true.
  -->
  <PropertyGroup Condition="'$(UseProjectReferences)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_PROJECT_REFERENCES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Common\App.Common.csproj" />
    <ProjectReference Include="..\..\contracts\App.World\App.World.csproj" />
    <ProjectReference Include="..\..\contracts\App.World.Rendering\App.World.Rendering.csproj" />
    <ProjectReference Include="..\..\contracts\App.NodeGraph\App.NodeGraph.csproj" />
    <ProjectReference Include="..\..\contracts\App.Ecs\App.Ecs.csproj" />
    <ProjectReference Include="..\..\contracts\App.Command\App.Command.csproj" />
    <ProjectReference Include="..\App.NodeGraph\App.NodeGraph.csproj" />
    <ProjectReference Include="..\App.World.Composition\App.World.Composition.csproj" />
    <ProjectReference Include="..\App.World.FieldView\App.World.FieldView.csproj" />
    <!--
      App.Ecs PLUGIN (not just contracts): CellElevationModel owns an Arch ECS world built from the
      app's primitive cell components (CellId/PlateId/CrustSample/CellUnit/Elevation) and runs
      CellElevationSystem over it. Those types are always-compiled (no engine types); the plugin's
      USE_PROJECT_REFERENCES-gated field-reduction path stays compiled-out in the package build.
    -->
    <ProjectReference Include="..\App.Ecs\App.Ecs.csproj" />
  </ItemGroup>

  <!--
    Cross-repo cartography consumption (dev-mode project references, mirroring the fantasim-world
    engine refs above). GlobePlateSurfaces (T3, Godot-free) feeds the tessellation + per-cell heights
    into the cartography GlobeSurfaceBuilder to produce WATERTIGHT per-plate caps. The cartography
    projects carry their own Directory.Build/Packages.props (UnifyMaths.Numerics 1.0.0, same feed line),
    so they compile self-consistently under a project reference — no CPM/TFM conflict (both net8.0).
    NOT packed to the NuGet feed (publishing needs owner approval / out of scope). These refs are
    UNGATED: unlike the engine refs there is no published cartography package to fall back to, and the
    watertight surface is the app's geometry now, not an optional co-dev path.

    NOTE (2026-07-03 rendering-contracts extraction): the rendering types that consumed cartography
    (GlobePlateSurfaces, ProvinceTint, VertexTintJitter, VertexColorEnvelope) moved to the shared
    contracts/App.World.Rendering project, which carries these cartography refs. The App.World PLUGIN
    keeps its cartography refs for now — the plugin still pulls the cartography assemblies into its
    compile scope transitively via App.World.Rendering, and the explicit refs document the dependency
    for the bundle staging audit. They can be removed once the bundle staging is re-verified.
  -->
  <ItemGroup>
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-cartography\project\contracts\Cartography.Shared\Cartography.Shared.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-cartography\project\contracts\Cartography.Globe\Cartography.Globe.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-cartography\project\plugins\Cartography.Globe.Core\Cartography.Globe.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- NU1603 (UnifyGeometry floor versions vs the 1.0.0 feed line) is informational, non-fatal. -->
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GiantCroissant.PluginArchi.Extensibility.Abstractions" />
    <PackageReference Include="GiantCroissant.PluginArchi.SourceGenerators" PrivateAssets="all" />
    <PackageReference Include="Akka" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="SurrealDb.Embedded.InMemory" />
    <PackageReference Include="SurrealDb.Net" />
    <PackageReference Include="UnifyStorage.Abstractions" />
    <PackageReference Include="UnifyStorage.Generators" PrivateAssets="all" />
    <PackageReference Include="UnifyStorage.Runtime.SurrealDb" />
    <!-- The ECS itself: CellElevationModel constructs an ArchSystemRunner directly (Godot-free,
         unit-testable) — same UnifyEcs+Arch stack App.Ecs uses; no second ECS, no hand-rolled world. -->
    <PackageReference Include="UnifyEcs.Core" />
    <PackageReference Include="UnifyEcs.Runtime.Arch" />
  </ItemGroup>

  <!--
    Engine consumption — hybrid (see project/Directory.Build.props):
      * UseProjectReferences=false (release): published packages from the local feed.
      * UseProjectReferences=true  (dev): project references to fantasim-world `main`. Geosphere.Crust
        project-refs its own deps (Topology/Fields/TruthStream), so the whole closure flows as `main`
        projects — no package/project version mixing.
    Crust + Topology + Shared back the always-compiled WorldFunctionProvider; Fields/Parameters/
    TruthStream back the full WorldRuntime composition (compiled under USE_PROJECT_REFERENCES).
  -->
  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="GiantCroissant.FantaSim.Geosphere.Crust" />
    <PackageReference Include="GiantCroissant.FantaSim.Geosphere.Plate.Topology.Generation" />
    <PackageReference Include="GiantCroissant.FantaSim.Geosphere.Plate.Topology.Contracts" />
    <PackageReference Include="GiantCroissant.FantaSim.Geosphere.Asthenosphere.Convection" />
    <PackageReference Include="GiantCroissant.FantaSim.Geosphere.Asthenosphere" />
    <PackageReference Include="GiantCroissant.FantaSim.Atmosphere.Genesis.Core" />
    <PackageReference Include="GiantCroissant.FantaSim.Atmosphere.Contracts" />
    <PackageReference Include="GiantCroissant.FantaSim.Geosphere.Plate.Topology.Materializer" />
    <PackageReference Include="GiantCroissant.FantaSim.World.Shared.Contracts" />
  </ItemGroup>
  <!-- engine: post-Plan-1-3 + atmosphere (codev) -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\plugins\Geosphere.Crust\Geosphere.Crust.csproj" />
    <!-- Renamed: Geosphere.Plate.Topology -> Geosphere.Plate.Topology.Generation (Plan 1-3) -->
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\plugins\Geosphere.Plate.Topology.Generation\Geosphere.Plate.Topology.Generation.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\contracts\Geosphere.Plate.Topology\Geosphere.Plate.Topology.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\plugins\Geosphere.Plate.Topology.Materializer\Geosphere.Plate.Topology.Materializer.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\plugins\Geosphere.Asthenosphere.Convection\Geosphere.Asthenosphere.Convection.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\contracts\Geosphere.Asthenosphere\Geosphere.Asthenosphere.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\plugins\Atmosphere.Genesis.Core\Atmosphere.Genesis.Core.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\contracts\Atmosphere\Atmosphere.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\contracts\World.Shared\World.Shared.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\contracts\World.Fields\World.Fields.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\plugins\World.Fields.Core\World.Fields.Core.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\contracts\World.Parameters\World.Parameters.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\contracts\World.TruthStream\World.TruthStream.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\plugins\World.TruthStream.Core\World.TruthStream.Core.csproj" />
  </ItemGroup>

</Project>
