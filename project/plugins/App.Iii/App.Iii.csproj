<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.Iii</RootNamespace>
    <AssemblyName>FantaSim.App.Iii</AssemblyName>
    <ServiceArchiTier>T3</ServiceArchiTier>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>

  <!--
    T3 iii-axis plugin: function provider + orchestrator + recipes. Pure C#, no Godot. Depends on
    the general App.NodeGraph executor + the App.Command IIiiOrchestration seam. The Godot-backed
    IIiiInvoker (IiiBridge) lives in App.Iii.Seam and is injected at composition.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\contracts\App.NodeGraph\App.NodeGraph.csproj" />
    <ProjectReference Include="..\..\contracts\App.Command\App.Command.csproj" />
    <ProjectReference Include="..\App.NodeGraph\App.NodeGraph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
