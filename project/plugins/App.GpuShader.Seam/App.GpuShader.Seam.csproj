<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.GpuShader.Seam</RootNamespace>
    <AssemblyName>FantaSim.App.GpuShader.Seam</AssemblyName>
    <ServiceArchiTier>T4</ServiceArchiTier>
    <!-- The RESIDENT shader seam: loads Godot Shader resources (incl. bundle PCK content) and reports
         DTO descriptions. It is not collectible; shader assets may hot-reload through PCK/resource
         replacement instead. Seam tier opts out of CPM (Godot SDK manages its package graph),
         mirroring the other App.*.Seam. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\contracts\App.GpuShader\App.GpuShader.csproj" />
    <ProjectReference Include="..\App.GpuShader\App.GpuShader.csproj" />
    <ProjectReference Include="..\App.Common\App.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>
</Project>
