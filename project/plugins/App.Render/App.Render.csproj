<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.Render</RootNamespace>
    <AssemblyName>FantaSim.App.Render</AssemblyName>
    <ServiceArchiTier>T3</ServiceArchiTier>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>

  <!--
    T3 render support: Godot-free payload/path/timestamp logic for the render.screenshot command.
    The T4 seam (App.Render.Seam) owns the Godot viewport capture; this project holds the
    pure-C# resolution so it is unit-testable without Godot. Mirrors the T3/T4 split used by
    App.Camera / App.Camera.Seam and App.Timeline / App.Timeline.Seam.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="App.Render.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>