<Project Sdk="Godot.NET.Sdk/4.7.0">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.Timeline.Seam</RootNamespace>
    <AssemblyName>FantaSim.App.Timeline.Seam</AssemblyName>
    <ServiceArchiTier>T4</ServiceArchiTier>
    <!-- The RESIDENT timeline seam: implements the T3 ITimelineFace with Godot's
         AnimationPlayer/AnimationTree + Control UI. Godot.NET.Sdk for GodotSharp. Stays
         resident (shared via "FantaSim.App." prefix) - it is the only Godot-aware piece;
         the timeline bundle itself ships no Godot types and its collectible ALC unloads
         cleanly. Mirrors App.Camera.Seam / App.World.Presentation.Seam. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>

  <ItemGroup>
    <!-- T1 contract (IService, DTOs, TimelineViewSnapshot, ITimelineFace, UI model helpers). -->
    <ProjectReference Include="..\..\contracts\App.Timeline\App.Timeline.csproj" />
    <ProjectReference Include="..\..\contracts\App.Presentation\App.Presentation.csproj" />
    <!-- App.World contracts for ITimelineController + SphereRegimeSchedule (the face resolves
         the controller from the registry passed at construction). -->
    <ProjectReference Include="..\..\contracts\App.World\App.World.csproj" />
    <!-- T1 command contract lets the resident timeline face dispatch user selections through
         the command/activity pipeline without depending on the T3 command implementation. -->
    <ProjectReference Include="..\..\contracts\App.Command\App.Command.csproj" />
    <!-- Reuses the resident GraphEdit binder/enhancer/layout path for expanded layer graphs. -->
    <ProjectReference Include="..\App.Ui.Seam\App.Ui.Seam.csproj" />
    <ProjectReference Include="..\..\generators\Cross.SourceGenerators\Cross.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\contracts\Cross.Abstractions\Cross.Abstractions.csproj" />
    <ProjectReference Include="..\App.Common\App.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tunnel slice-1 (vault/plans/2026-07-11-tunnel-slice1-plan.md Task 6): App.Presentation
         (world bundle) consumes the tunnel pure-math modules + IFilmstripFrameSink. Assembly
         name, not folder name — App.Presentation overrides <AssemblyName>. -->
    <InternalsVisibleTo Include="FantaSim.App.Presentation" />
  </ItemGroup>

</Project>
