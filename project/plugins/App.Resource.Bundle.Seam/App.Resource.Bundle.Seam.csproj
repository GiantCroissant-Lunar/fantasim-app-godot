<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.Resource.Bundle</RootNamespace>
    <AssemblyName>FantaSim.App.Resource.Bundle.Seam</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <ServiceArchiTier>T4</ServiceArchiTier>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\contracts\App.Resource\App.Resource.csproj" />
    <!-- SceneTierPckWatcher (moved here from the host, 2026-07-03) dispatches
         resource.reload_bundle through the command contract. -->
    <ProjectReference Include="..\..\contracts\App.Command\App.Command.csproj" />
    <ProjectReference Include="..\App.Resource\App.Resource.csproj" />
    <ProjectReference Include="..\App.Common\App.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GiantCroissant.PluginArchi.Extensibility.Abstractions" Version="0.1.6" />
    <PackageReference Include="GiantCroissant.PluginArchi.Extensibility.Hosting" Version="0.1.6" />
    <PackageReference Include="GiantCroissant.RegistryArchi.Contracts" Version="0.1.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <!-- R3 for the frame-deferred ALC-collection gate in VerifyOldContextCollectedAsync (mirrors the
         pure ReloadPolicy in App.Resource). CPM is OFF for this project, so the version is inline.
         Pinned to 1.3.1 to match Directory.Packages.props and the vendored addons/R3.Godot (R3 1.3.1). -->
    <PackageReference Include="R3" Version="1.3.1" />
  </ItemGroup>
</Project>
