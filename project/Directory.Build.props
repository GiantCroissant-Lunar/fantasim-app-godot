<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);GeneratedOut\**;**\GeneratedOut\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Default consumption mode. false = published packages from the local feed (reproducible,
         release/CI). Set true for project references to fantasim-world `main` during active engine
         co-development. Phase 0 gated to 0.1.4 packages (rad/tick); set true again for Phase 1+ co-dev. -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">false</UseProjectReferences>
    <PlateProjectsRoot Condition="'$(PlateProjectsRoot)' == ''">/Users/apprenticegc/Work/lunar-horse/plate-projects</PlateProjectsRoot>
    <YokanProjectsRoot Condition="'$(YokanProjectsRoot)' == ''">/Users/apprenticegc/Work/lunar-horse/yokan-projects</YokanProjectsRoot>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Cross.Abstractions'">
    <Compile Include="$(MSBuildThisFileDirectory)contracts\Cross.Abstractions\Polyfills\IsExternalInit.cs"
             Link="Polyfills\IsExternalInit.cs" />
  </ItemGroup>

</Project>
