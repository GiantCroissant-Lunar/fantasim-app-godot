<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Schema-first DTO scratch output is generated for inspection/codegen tests, not compiled into contracts. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);GeneratedOut\**;**\GeneratedOut\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Default consumption mode. true = project references to fantasim-world `main` (codev, feat/app-regimes-onset-timeline).
         Set false for published packages (release/CI reproducible path; package-mode bump recorded in Directory.Packages.props). -->
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>
    <PlateProjectsRoot Condition="'$(PlateProjectsRoot)' == ''">/Users/apprenticegc/Work/lunar-horse/plate-projects</PlateProjectsRoot>
    <YokanProjectsRoot Condition="'$(YokanProjectsRoot)' == ''">/Users/apprenticegc/Work/lunar-horse/yokan-projects</YokanProjectsRoot>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Cross.Abstractions'">
    <Compile Include="$(MSBuildThisFileDirectory)contracts\Cross.Abstractions\Polyfills\IsExternalInit.cs"
             Link="Polyfills\IsExternalInit.cs" />
  </ItemGroup>

</Project>
