<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The same WorldHistoryCoordinator and truth-store behavior is tested in both dependency modes. -->
  </PropertyGroup>
  <!-- NU1603: UnifyGeometry floor versions vs the 1.0.0 feed line; informational, non-fatal. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="GiantCroissant.ServiceArchi.Core" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\App.World\App.World.csproj" />
    <ProjectReference Include="..\..\contracts\App.World\App.World.csproj" />
    <!-- Rendering contracts (shared): the moved rendering/globe types (GlobePlateSurfaces,
         VertexColorEnvelope, VerticalScaleLabel, HypsometricTint, WorldTerrainRamp, ProvinceTint,
         VertexTintJitter, CrustAccentMapper, AtmosphereRimStateMapper, BoundaryStyleMapper,
         PlateIdentityPalette, RampColor) now live here. The test files keep their existing usings
         (FantaSim.App.World.Rendering / .Globe) — the namespaces are preserved exactly. -->
    <ProjectReference Include="..\..\contracts\App.World.Rendering\App.World.Rendering.csproj" />
    <!-- The general graph executor (plugin) + its contracts: the crust recipe is run through the REAL
         GraphExecutor with the WorldFunctionProvider, no Godot. -->
    <ProjectReference Include="..\..\plugins\App.NodeGraph\App.NodeGraph.csproj" />
    <ProjectReference Include="..\..\contracts\App.NodeGraph\App.NodeGraph.csproj" />
  </ItemGroup>

  <!-- Cosmology hybrid references: contracts + registry + science.
       The default-world authoring tests construct a real registry, invoke science authoring,
       then invoke DefaultWorldDeclarationAuthoring to prove cross-repo anti-drift. -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="$(FantaSimWorldRoot)\project\contracts\Mythosphere.Cosmology\Mythosphere.Cosmology.csproj" />
    <ProjectReference Include="$(FantaSimWorldRoot)\project\plugins\Mythosphere.Cosmology.Registry\Mythosphere.Cosmology.Registry.csproj" />
    <ProjectReference Include="$(FantaSimWorldRoot)\project\plugins\Mythosphere.Cosmology.Science\Mythosphere.Cosmology.Science.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="GiantCroissant.FantaSim.Mythosphere.Cosmology.Contracts" />
    <PackageReference Include="GiantCroissant.FantaSim.Mythosphere.Cosmology.Registry" />
    <PackageReference Include="GiantCroissant.FantaSim.Mythosphere.Cosmology.Science" />
  </ItemGroup>
</Project>
