<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      Catalog validation and DTO mapping tests exercise the real WorldRuntime
      composition, which is only compiled when USE_PROJECT_REFERENCES is defined
      (the local feed lacks FantaSim.World.* packages). The test project mirrors
      the plugin's define so the real path is compiled here too.
    -->
    <DefineConstants Condition="'$(UseProjectReferences)' == 'true'">$(DefineConstants);USE_PROJECT_REFERENCES</DefineConstants>
  </PropertyGroup>
  <!-- NU1603: UnifyGeometry floor versions vs the 1.0.0 feed line; informational, non-fatal. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1603</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="GiantCroissant.ServiceArchi.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\App.World\App.World.csproj" />
    <ProjectReference Include="..\..\contracts\App.World\App.World.csproj" />
    <!-- The general graph executor (plugin) + its contracts: the crust recipe is run through the REAL
         GraphExecutor with the WorldFunctionProvider, no Godot. -->
    <ProjectReference Include="..\..\plugins\App.NodeGraph\App.NodeGraph.csproj" />
    <ProjectReference Include="..\..\contracts\App.NodeGraph\App.NodeGraph.csproj" />
  </ItemGroup>
</Project>