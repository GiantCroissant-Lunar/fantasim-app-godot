<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      Field-reduction determinism and cross-path tests exercise the real ReduceFieldsSystem
      composition path, which is only compiled when USE_PROJECT_REFERENCES is defined
      (the local lunar-horse feed lacks FantaSim.World.* packages). The test project mirrors
      the plugin's define so the real path is compiled here too, and pulls in the sibling
      World.Fields/World.Fields.Core + World.TruthStream/World.TruthStream.Core project refs
      needed for the reducer/catalog and the truth-stream materialization comparison.
    -->
    <DefineConstants Condition="'$(UseProjectReferences)' == 'true'">$(DefineConstants);USE_PROJECT_REFERENCES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Akka.TestKit.Xunit2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\App.Ecs\App.Ecs.csproj" />
    <ProjectReference Include="..\..\contracts\App.Ecs\App.Ecs.csproj" />
  </ItemGroup>
  <!--
    Sibling fantasim-world project refs for the field-reduction + cross-path determinism tests.
    World.Fields.Core transitively brings in World.Fields (+ TimeDete.Time.Primitives +
    RegistryArchi). World.TruthStream.Core brings in World.TruthStream (+ MessagePack +
    UnifySerialization.MessagePack.Runtime). All present in the local lunar-horse feed.
  -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\contracts\World.Fields\World.Fields.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\plugins\World.Fields.Core\World.Fields.Core.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\contracts\World.TruthStream\World.TruthStream.csproj" />
    <ProjectReference Include="$(YokanProjectsRoot)\fantasim-world\project\plugins\World.TruthStream.Core\World.TruthStream.Core.csproj" />
  </ItemGroup>
</Project>
