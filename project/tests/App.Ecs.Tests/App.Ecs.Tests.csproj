<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      Field-reduction determinism and cross-path tests exercise the real ReduceFieldsSystem
      composition path, which is only compiled when USE_PROJECT_REFERENCES is defined
      The test project mirrors the plugin's define so the real path is compiled here too,
      and pulls the world-lib packages needed for reducer/catalog and truth-stream comparison.
    -->
    <DefineConstants Condition="'$(UseProjectReferences)' == 'true'">$(DefineConstants);USE_PROJECT_REFERENCES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Akka.TestKit.Xunit2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\App.Ecs\App.Ecs.csproj" />
    <ProjectReference Include="..\..\contracts\App.Ecs\App.Ecs.csproj" />
  </ItemGroup>
  <!--
    World-lib packages for the field-reduction + cross-path determinism tests.
  -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <PackageReference Include="GiantCroissant.FantaSim.World.Fields.Contracts" />
    <PackageReference Include="GiantCroissant.FantaSim.World.Fields.Core" />
    <PackageReference Include="GiantCroissant.FantaSim.World.TruthStream.Contracts" />
    <PackageReference Include="GiantCroissant.FantaSim.World.TruthStream.Core" />
  </ItemGroup>
</Project>
