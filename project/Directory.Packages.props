<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="R3" Version="1.3.1" />
    <PackageVersion Include="DynamicData" Version="9.4.31" />
    <PackageVersion Include="GiantCroissant.PluginArchi.Extensibility.Abstractions" Version="0.1.6" />
    <PackageVersion Include="GiantCroissant.PluginArchi.Extensibility.Hosting" Version="0.1.6" />
    <PackageVersion Include="GiantCroissant.PluginArchi.Extensibility.Hosting.Abstractions" Version="0.1.6" />
    <PackageVersion Include="GiantCroissant.PluginArchi.SourceGenerators" Version="0.1.6" PrivateAssets="all" />
    <PackageVersion Include="GiantCroissant.ServiceArchi.Contracts" Version="0.1.1" />
    <PackageVersion Include="GiantCroissant.ServiceArchi.Core" Version="0.1.1" />
    <PackageVersion Include="GiantCroissant.ServiceArchi.SourceGen" Version="0.1.1" PrivateAssets="all" />
    <PackageVersion Include="GiantCroissant.RegistryArchi.Contracts" Version="0.1.2" />
    <PackageVersion Include="GiantCroissant.RegistryArchi.Core" Version="0.1.2" />
    <PackageVersion Include="GiantCroissant.DependencyArchi.Abstractions" Version="0.1.1" />
    <PackageVersion Include="GiantCroissant.DependencyArchi.MicrosoftExtensions" Version="0.1.1" />
    <PackageVersion Include="GiantCroissant.DependencyArchi.SourceGenerators" Version="0.1.1" PrivateAssets="all" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Messaging.Contracts" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Messaging.MessagePipe" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Messaging.MessagePipe.ServiceArchi" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Logging.Contracts" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Logging.Core" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Logging.Console" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Logging.Console.ServiceArchi" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Logging.ServiceArchi" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Config.Contracts" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Config.Core" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Config.Json" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Config.Json.ServiceArchi" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Config.Env" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Config.Env.ServiceArchi" Version="0.2.2" />
    <PackageVersion Include="GiantCroissant.CrosscutFoundation.Config.ServiceArchi" Version="0.2.2" />
    <PackageVersion Include="BoomHud.Foundation" Version="0.1.47" />
    <PackageVersion Include="BoomHud.Godot.Runtime" Version="0.1.47" />
    <PackageVersion Include="UnifyEcs.Core" Version="0.1.1" />
    <PackageVersion Include="UnifyEcs.Runtime.Arch" Version="0.1.1" />
    <!-- Activity ledger persistence (LiteDB-backed document store). Also backs the resident
         crust-product cache store (App.Common, 2026-07-11 persistence slice 1). -->
    <PackageVersion Include="UnifyStorage.Abstractions" Version="0.1.1" />
    <PackageVersion Include="UnifyStorage.Generators" Version="0.1.1" PrivateAssets="all" />
    <PackageVersion Include="UnifyStorage.Runtime.LiteDb" Version="0.1.0" />
    <PackageVersion Include="UnifyStorage.Runtime.SurrealDb" Version="0.1.1" />
    <!-- MessagePack: pinned to the version already resolved transitively via fantasim-world's
         World.TruthStream.Core (MessagePackTruthEventSerializer) so App.World.Contracts' explicit
         reference doesn't introduce a second version to reconcile. Used to encode the crust-product
         persistence payload (project/contracts/App.World/Persistence), matching the house's
         "canonical event encoding: MessagePack" convention (unify-storage 04-persistence.md). -->
    <PackageVersion Include="MessagePack" Version="3.1.7" />
    <PackageVersion Include="MessagePack.Annotations" Version="3.1.7" />
    <PackageVersion Include="SurrealDb.Net" Version="0.10.2" />
    <PackageVersion Include="SurrealDb.Embedded.InMemory" Version="0.10.2" />
    <!-- FantaSim engine packages are published as one compatible closure. 0.1.12 adds the
         authoritative caller-supplied boundary-type crust-pipeline seam used by App.World. -->
    <PackageVersion Include="GiantCroissant.FantaSim.World.Fields.Contracts" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.World.Fields.Core" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.World.Parameters.Contracts" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.World.TruthStream.Contracts" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.World.TruthStream.Core" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Geosphere.Crust" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Geosphere.Plate.Topology.Generation" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Geosphere.Plate.Topology.Contracts" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Geosphere.Plate.Topology.Materializer" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Geosphere.Plate.Rotation.Stream" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Geosphere.Plate.Reconstruction" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Geosphere.Asthenosphere.Convection" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Geosphere.Asthenosphere.Contracts" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Atmosphere.Genesis.Core" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.Atmosphere.Contracts" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.World.Fields.Catalog" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.World.Fields.Stream" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.World.Export.Contracts" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.World.Generation.Contracts" Version="0.1.12" />
    <PackageVersion Include="GiantCroissant.FantaSim.World.Shared.Contracts" Version="0.1.12" />
    <!-- Geometry / math / time deps in the crust closure (local feed). Pinned so CPM
         resolves them deterministically. -->
    <PackageVersion Include="UnifyCell.Core" Version="0.1.1" />
    <PackageVersion Include="UnifyCell.Abstractions" Version="0.1.1" />
    <PackageVersion Include="UnifyGeometry.Spherical" Version="0.1.5" />
    <PackageVersion Include="UnifyGeometry.Kernel" Version="0.1.5" />
    <PackageVersion Include="UnifyGeometry.Primitives" Version="0.1.5" />
    <PackageVersion Include="UnifyMaths" Version="0.1.5" />
    <PackageVersion Include="UnifyMaths.Numerics" Version="0.1.5" />
    <!-- Cartography impl consumed as a package (contracts stay project refs — same assembly
         names via the cartography csproj AssemblyName pins, so no type-identity split). -->
    <PackageVersion Include="GiantCroissant.FantaSim.Cartography.Globe.Core" Version="0.1.0" />
    <!-- Cosmology declaration registry: contracts (resident-shared), registry + science
         (collectible world-bundle companions). Published at 0.1.14 from fantasim-world. -->
    <PackageVersion Include="GiantCroissant.FantaSim.Mythosphere.Cosmology.Contracts" Version="0.1.14" />
    <PackageVersion Include="GiantCroissant.FantaSim.Mythosphere.Cosmology.Registry" Version="0.1.14" />
    <PackageVersion Include="GiantCroissant.FantaSim.Mythosphere.Cosmology.Science" Version="0.1.14" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Akka" Version="1.5.69" />
    <PackageVersion Include="Akka.TestKit.Xunit2" Version="1.5.69" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Source generators (Roslyn): the app-internal Cross.SourceGenerators forwarding generator
       builds against these; netstandard2.0 analyzer consumed via OutputItemType=Analyzer. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
  </ItemGroup>

</Project>
