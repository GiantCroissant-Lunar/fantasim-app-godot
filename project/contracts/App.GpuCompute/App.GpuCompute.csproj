<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FantaSim.App.GpuCompute</RootNamespace>
    <AssemblyName>FantaSim.App.GpuCompute.Contracts</AssemblyName>
    <!-- ServiceArchi Tier 1: engine-agnostic compute-dispatch contract + T2 proxy.
         Godot RenderingDevice types and native RIDs stay in the resident T4 seam.
         (Mirrors App.World / App.Ecs contracts.) -->
    <ServiceArchiTier>T1</ServiceArchiTier>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="ServiceArchiTier" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GiantCroissant.PluginArchi.Extensibility.Abstractions" />
    <PackageReference Include="GiantCroissant.ServiceArchi.Contracts" />
    <PackageReference Include="GiantCroissant.ServiceArchi.SourceGen" PrivateAssets="all" />
  </ItemGroup>
</Project>
