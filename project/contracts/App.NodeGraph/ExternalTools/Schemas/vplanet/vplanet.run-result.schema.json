{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fantasim.local/external-tools/vplanet/vplanet.run-result.schema.json",
  "title": "VPLanet Run Result",
  "type": "object",
  "properties": {
    "job_id": { "type": "string" },
    "rootPath": { "type": "string" },
    "stdoutPath": { "type": "string" },
    "stderrPath": { "type": "string" },
    "outputPath": { "type": "string" },
    "returnCode": { "type": "integer" },
    "fallback": { "type": "boolean" },
    "available": { "type": "boolean" }
  },
  "required": [ "job_id", "rootPath", "stdoutPath", "stderrPath", "outputPath", "returnCode", "fallback", "available" ],
  "additionalProperties": false
}
