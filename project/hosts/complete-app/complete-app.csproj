<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>CompleteApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\App.Common\App.Common.csproj" />
    <ProjectReference Include="..\..\contracts\App.World\App.World.csproj" />
    <!-- SHARED rendering contracts (2026-07-03 ALC pin diagnosis, Fix 2): the resident host's
         PlanetPresentationBinder consumes GlobePlateSurfaces, the RampColor mappers, CutawayWedge/
         StratumProfile, VerticalScaleLabel etc. These types now live in a shared contract assembly
         (FantaSim.App.World.Rendering) that loads ONCE into the resident ALC — the collectible world
         bundle gets its own copy via the same ProjectReference, but the SharedAssemblyPolicy
         (Bootstrap.cs) keeps both sides on the RESIDENT copy so there is no type-identity split.

         The PREVIOUS ProjectReference to plugins\App.World\App.World.csproj (the collectible bundle's
         own plugin assembly) is REMOVED: it caused FantaSim.App.World.dll to load into BOTH the resident
         ALC (startup) AND the collectible ALC (bundle load), splitting type identity for
         GlobePlateSurfaces and every rendering helper. The host now compiles against the shared
         rendering contracts only; the world bundle's plugin assembly stays collectible. -->
    <ProjectReference Include="..\..\contracts\App.World.Rendering\App.World.Rendering.csproj" />
    <ProjectReference Include="..\..\plugins\App.Resource\App.Resource.csproj" />
    <ProjectReference Include="..\..\plugins\App.Resource.Bundle.Seam\App.Resource.Bundle.Seam.csproj" />
    <ProjectReference Include="..\..\plugins\App.SceneFlow\App.SceneFlow.csproj" />
    <ProjectReference Include="..\..\plugins\App.Ecs\App.Ecs.csproj" />
    <ProjectReference Include="..\..\plugins\App.Command\App.Command.csproj" />
    <ProjectReference Include="..\..\plugins\App.Ui\App.Ui.csproj" />
    <ProjectReference Include="..\..\plugins\App.Ui.Seam\App.Ui.Seam.csproj" />
    <ProjectReference Include="..\..\plugins\App.Activity\App.Activity.csproj" />
    <ProjectReference Include="..\..\plugins\App.NodeGraph\App.NodeGraph.csproj" />
    <ProjectReference Include="..\..\plugins\App.Ui.NodeGraph\App.Ui.NodeGraph.csproj" />
    <ProjectReference Include="..\..\plugins\App.Iii\App.Iii.csproj" />
    <ProjectReference Include="..\..\plugins\App.Iii.Seam\App.Iii.Seam.csproj" />
    <ProjectReference Include="..\..\plugins\App.GpuCompute\App.GpuCompute.csproj" />
    <ProjectReference Include="..\..\plugins\App.GpuCompute.Seam\App.GpuCompute.Seam.csproj" />
    <ProjectReference Include="..\..\plugins\App.GpuShader\App.GpuShader.csproj" />
    <ProjectReference Include="..\..\plugins\App.GpuShader.Seam\App.GpuShader.Seam.csproj" />
    <ProjectReference Include="..\..\plugins\App.Audio\App.Audio.csproj" />
    <!-- Virtual-camera service: T3 (App.Camera, engine-agnostic orchestrator) + T4 (App.Camera.Seam,
         the Godot camera rig over the vendored phantom-camera addon). -->
    <ProjectReference Include="..\..\plugins\App.Camera\App.Camera.csproj" />
    <ProjectReference Include="..\..\plugins\App.Camera.Seam\App.Camera.Seam.csproj" />
    <!-- Timeline service: T3 (App.Timeline, engine-agnostic orchestrator) + T4 (App.Timeline.Seam,
         the Godot timeline face). -->
    <ProjectReference Include="..\..\plugins\App.Timeline\App.Timeline.csproj" />
    <ProjectReference Include="..\..\plugins\App.Timeline.Seam\App.Timeline.Seam.csproj" />
    <!-- Remote command ingress: T3 (App.Remote, HTTP transport over the command IClient) + T4
         (App.Remote.Seam, the Godot main-thread bridge node). Gated by FANTASIM_REMOTE_ENABLED=1. -->
    <ProjectReference Include="..\..\plugins\App.Remote\App.Remote.csproj" />
    <ProjectReference Include="..\..\plugins\App.Remote.Seam\App.Remote.Seam.csproj" />
    <!-- Render seam: T4 (App.Render.Seam, Godot viewport capture) registers the render.screenshot
         command. T3 (App.Render) holds the Godot-free payload/path/timestamp logic. -->
    <ProjectReference Include="..\..\plugins\App.Render\App.Render.csproj" />
    <ProjectReference Include="..\..\plugins\App.Render.Seam\App.Render.Seam.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- R3.Godot addon (vendored under addons/R3.Godot) provides the FrameProviderDispatcher autoload,
         which sets ObservableSystem.DefaultFrameProvider to GodotFrameProvider.Process; consumed by
         BundleHost's frame-deferred ALC-collection gate (S2b). CPM is off here, so the version is inline
         (matches Directory.Packages.props + the vendored addon, R3 1.3.1). -->
    <PackageReference Include="R3" Version="1.3.1" />

    <!-- SHARED-CLOSURE self-ownership: these assemblies are promised RESIDENT by the
         SharedAssemblyPolicy + the Taskfile world-bundle mirror (the bundle deliberately ships
         WITHOUT them), but they used to reach the host output only TRANSITIVELY through the
         removed plugins\App.World ProjectReference. Removing it silently dropped them from the
         export and crust generation failed with FileNotFoundException (2026-07-03). The host owns
         its shared promise explicitly now; versions pin the same 0.2.0 the world bundle's engine
         assemblies bind against. -->
    <PackageReference Include="GiantCroissant.CrosscutFoundation.Persistence.Abstractions" Version="0.2.0" />
    <PackageReference Include="UnifySerialization.MessagePack.Runtime" Version="0.2.0" />
  </ItemGroup>

  <!-- Vendored phantom-camera addon (v0.11.0.2, GDScript at runtime). Its bundled C# wrapper sources
       are compiled into the App.Camera SEAM (App.Camera.Seam pulls them via Compile Include), not the
       host assembly - exclude them here so the types exist exactly once. -->
  <ItemGroup>
    <Compile Remove="addons\phantom_camera\**\*.cs" />
  </ItemGroup>
</Project>
