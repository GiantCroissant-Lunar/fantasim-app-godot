[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
; Lib lives INSIDE res:// (project/hosts/complete-app/bin) so it bundles into
; exports. `task bridge:build` copies the cargo output here (debug for dev;
; the export task copies the release build over it). Same file for debug+release.
macos.debug          = "res://bin/libiii_bridge.dylib"
macos.release        = "res://bin/libiii_bridge.dylib"
linux.debug.x86_64   = "res://bin/libiii_bridge.so"
linux.release.x86_64 = "res://bin/libiii_bridge.so"
windows.debug.x86_64   = "res://bin/iii_bridge.dll"
windows.release.x86_64 = "res://bin/iii_bridge.dll"
