{
  "protocolVersion": "0.1",
  "surfaceId": "activity",
  "catalogId": "boomhud.runtime.basic.v1",
  "root": {
    "id": "root",
    "type": "container",
    "layout": {
      "type": "vertical",
      "gap": 8
    },
    "children": [
      {
        "id": "activity-title",
        "type": "label",
        "properties": {
          "text": {
            "literal": "${activity.title}"
          },
          "variant": {
            "literal": "title"
          }
        }
      },
      {
        "id": "activity-toolbar",
        "type": "container",
        "layout": {
          "type": "horizontal",
          "gap": 8,
          "align": "center"
        },
        "children": [
          {
            "id": "activity-refresh",
            "type": "button",
            "properties": {
              "text": {
                "literal": "Refresh"
              }
            },
            "actions": [
              {
                "event": "pressed",
                "command": "refresh"
              }
            ]
          },
          {
            "id": "activity-hide",
            "type": "button",
            "properties": {
              "text": {
                "literal": "Hide"
              }
            },
            "actions": [
              {
                "event": "pressed",
                "command": "hide"
              }
            ]
          },
          {
            "id": "activity-toolbar-spacer",
            "type": "spacer"
          }
        ]
      },
      {
        "id": "activity-scroll",
        "type": "scroll",
        "children": [
          {
            "id": "activity-rows",
            "type": "container",
            "layout": {
              "type": "vertical",
              "gap": 6
            },
            "children": [
              {
                "slot": "activityRows"
              }
            ]
          }
        ]
      }
    ]
  }
}
