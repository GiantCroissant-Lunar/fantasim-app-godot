<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for this repo are declared ONCE at the lunar-horse workspace root:
      <workspace-root>/nuget.config   (/Users/apprenticegc/Work/lunar-horse/nuget.config)
  NuGet finds it by walking up the directory tree, and its `lunar-horse-local` feed path
  resolves relative to the root — so it works from a normal checkout AND from git worktrees
  at any depth, with no per-repo relative feed path and no yokan-projects/packages symlink.

  Intentionally NO <packageSources> and NO <clear/> here: a <clear/> would wipe the
  inherited root sources and reintroduce the worktree feed-resolution failure that makes
  agents recreate the packages symlink. See yokan-projects/README.md for the rationale.
-->
<configuration>
</configuration>
