# Godot 4+ specific ignores
.godot/
/android/

# .NET build artifacts
bin/
obj/
*.user
*.suo
*.userprefs
*.pidb
*.bock
*.lock.json
*.nuget.props
*.nuget.targets

# dotnet test artifacts (xUnit/TRX drops per test project)
**/TestResults/

# Godot mono temp
.godot/mono/
.nuke/temp/

# Tool outputs
repomix-output.*
CHANGELOG.md

# Staged collectible-bundle plugin DLLs (copied from each tier's build output before PCK export).
# Bundle sources (manifest.json + scenes) are tracked; the packed .dll is a build artifact.
project/bundles/*/*.dll

# Build-generated symlink (bundle:link): content-app/bundles -> ../../bundles
project/hosts/content-app/bundles

# Python iii-worker virtualenv + caches (workers themselves are tracked)
project/workers/.venv/
**/__pycache__/

# Rust gdext bridge: cargo build output + the staged dylib (rebuilt by `task bridge:build`)
project/target/
project/hosts/complete-app/bin/*.dylib
project/hosts/complete-app/bin/*.so
project/hosts/complete-app/bin/*.dll

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# iii engine --use-default-config runtime data written to cwd; Godot csproj backups
data/
*.csproj.old

.omo/

# Agent-resource sync OUTPUT (deployed/generated by the workspace sync from .agent/ + AGENTS.md).
# The .agent/ source dir and AGENTS.md are tracked; these copies are regenerable, so ignore them.
.agents/
.claude/
CLAUDE.md
# codegraph local index (added 2026-06-23)
.codegraph/

# agent-session scratch (delegation logs + staged dispatch prompts) - not source
.agent/logs/
.agent/run/
