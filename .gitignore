# Godot 4+ specific ignores
.godot/
/android/

# .NET build artifacts
bin/
obj/
# Exception: the host's native-lib bin/ holds the tracked GDExtension descriptor + .uid
# (source) alongside the gitignored dylib/.so/.dll staged by `task bridge:build`.
# Re-include the directory, then re-ignore the build artifacts inside it.
!project/hosts/complete-app/bin/
project/hosts/complete-app/bin/*
!project/hosts/complete-app/bin/*.gdextension
!project/hosts/complete-app/bin/*.gdextension.uid
*.user
*.suo
*.userprefs
*.pidb
*.bock
*.lock.json
*.nuget.props
*.nuget.targets

# dotnet test artifacts (xUnit/TRX drops per test project)
**/TestResults/

# Godot mono temp
.godot/mono/
.nuke/temp/

# Tool outputs
repomix-output.*
**/GeneratedOut/

# Staged collectible-bundle plugin DLLs (copied from each tier's build output before PCK export).
# Bundle sources (manifest.json + scenes) are tracked; the packed .dll is a build artifact.
project/bundles/*/*.dll
project/bundles/*/*.deps.json
# common's manifest is GENERATED by stage_bundle.py --stage-common (per-build sha256s) —
# unlike the hand-maintained scene-tier manifests, it must not be committed
project/bundles/common/manifest.json

# Build-generated symlink (bundle:link): content-app/bundles -> ../../bundles
project/hosts/content-app/bundles

# Python iii-worker virtualenv + caches (workers themselves are tracked)
project/workers/.venv/
**/__pycache__/

# Rust gdext bridge: cargo build output (rebuilt by `task bridge:build`)
project/target/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# iii engine --use-default-config runtime data written to cwd; Godot csproj backups
data/
*.csproj.old

.omo/

# Agent-resource sync OUTPUT (deployed/generated by the workspace sync from .agent/ + AGENTS.md).
# The .agent/ source dir and AGENTS.md are tracked; these copies are regenerable, so ignore them.
.agents/
.claude/
CLAUDE.md
# codegraph local index (added 2026-06-23)
.codegraph/

# agent-session scratch (delegation logs + staged dispatch prompts) - not source
.agent/logs/
.agent/run/

# Plate-rate calibration: downloaded Cao et al. 2024 dataset (Zenodo, CC-BY-4.0).
# Re-fetch with tools/rates/fetch-cao2024.sh — do not commit third-party data.
tools/rates/data/
